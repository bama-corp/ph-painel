# =============================================================================
# PH Painel — variáveis de ambiente
# Copiar para .env e preencher. Nunca commits .env com valores reais.
# =============================================================================

# --- Neon (PostgreSQL) — dados financeiros do PH ---
# Console: https://console.neon.tech → Connection string
# Usar a URL *pooled* (com -pooler) em DATABASE_URL.
# NÃO uses prefixo VITE_ — a BD nunca vai para o browser.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# API local (server/dev-api) e funções Vercel /api/state
PH_API_PORT=8787
# Opcional: se definido, GET/PUT /api/state exige Authorization: Bearer …
PH_API_KEY=""
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Frontend → API do próprio PH (vazio em local = proxy Vite /api → :8787)
VITE_PH_API_URL=""
VITE_PH_API_KEY=""

# --- API Plural (já usa Neon no plural-painel) — leitura clientes/MRR ---
VITE_PLURAL_API_URL="http://localhost:3001"
VITE_PLURAL_API_KEY=""
