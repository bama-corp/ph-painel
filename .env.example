# =============================================================================
# PH Painel — variáveis de ambiente
# Copiar para .env e preencher. Nunca commits .env com valores reais.
# =============================================================================

# --- Neon (PostgreSQL) — dados financeiros do PH ---
# Console: https://console.neon.tech → Connection string
# Usar a URL *pooled* (com -pooler) em DATABASE_URL.
# NÃO uses prefixo VITE_ — a BD nunca vai para o browser.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Neon (PostgreSQL) — TAREFAS (projecto/BD SEPARADO do financeiro) ---
# Cria outro projecto no Neon e cola a connection string pooled aqui.
TASKS_DATABASE_URL="postgresql://USER:PASSWORD@ep-YYYY-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# API local (server/dev-api) e funções Vercel /api/state + /api/tasks
PH_API_PORT=8787
# Opcional: se definido, GET/PUT exigem Authorization: Bearer …
PH_API_KEY=""
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Frontend → API do próprio PH (vazio em local = proxy Vite /api → :8787)
VITE_PH_API_URL=""
VITE_PH_API_KEY=""

# --- Alertas telemóvel (Tarefas) — ntfy ---
# 1) Instala a app ntfy (Android/iOS) ou usa https://ntfy.sh
# 2) Subscreve um tópico secreto (nome longo, só teu) — só o NOME, não a URL
# 3) Cola o mesmo nome em NTFY_TOPIC no ficheiro .env (não neste .example)
NTFY_TOPIC="ph-painel-teu-topico-secreto"
# Opcional (default = https://ntfy.sh):
# NTFY_SERVER="https://ntfy.sh"
# Ao tocar na notificação, abre este URL (ex. https://teu-dominio.vercel.app/tarefas):
# NOTIFY_CLICK_URL="https://teu-dominio.vercel.app/tarefas"
# Segredo para cron / botão na UI (string aleatória — NÃO é a URL do ntfy):
NOTIFY_SECRET=""
# Na Vercel, define também CRON_SECRET com o mesmo valor (Bearer do cron 07:00).
# CRON_SECRET=""
# Telegram (opcional — ntfy tem prioridade se ambos existirem):
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""

# --- Ponte Plural (servidor PH → plural-painel) ---
# A chave NÃO vai para o browser. O frontend chama /api/plural/summary|status.
# No Plural: a mesma chave em PH_API_KEY + PH_PANEL_URL=URL deste PH + CORS_ORIGINS.
# Docs: plural-painel/docs/PH-API.md
PLURAL_API_URL="http://localhost:3001"
PLURAL_API_KEY=""
# Opcional: segredo só para webhook (senão = PLURAL_API_KEY)
# PLURAL_HOOK_SECRET=""
# Deep link (frontend Plural) — abre /clientes?id= a partir da tabela PH
VITE_PLURAL_APP_URL="http://localhost:5174"
# Legado (ainda lido pelo servidor se PLURAL_* estiver vazio):
# VITE_PLURAL_API_URL="http://localhost:3001"
# VITE_PLURAL_API_KEY=""

# --- Assistente LLM (opcional) — Groq; só interpreta; o motor local valida ---
# Chave: https://console.groq.com/keys
GROQ_API_KEY=""
# Modelo Groq (default: llama-3.3-70b-versatile)
# ASSIST_MODEL="llama-3.3-70b-versatile"
# ASSIST_MODEL="openai/gpt-oss-120b"
