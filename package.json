{
  "name": "ph-painel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/dev-api.mjs",
    "dev:all": "concurrently -n api,web -c cyan,magenta npm:dev:api npm:dev",
    "db:migrate": "tsx scripts/migrate-seed.ts",
    "db:seed": "tsx scripts/migrate-seed.ts --force",
    "db:check": "node scripts/check-env.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "framer-motion": "^12.23.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.0"
  }
}
